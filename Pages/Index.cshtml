@page
@model IndexModel
@using WarrantyClaims.Models
@using WarrantyClaims.Services
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Claims";
}

<h1>@ViewData["Title"]</h1>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label for="SearchTerm" class="form-label">Search</label>
        <input type="text" id="SearchTerm" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Customer name or serial number" />
    </div>
    <div class="col-auto">
        <label for="StatusFilter" class="form-label">Status</label>
        <select asp-for="StatusFilter" class="form-select" asp-items="Html.GetEnumSelectList<ClaimStatus>()">
            <option value="">-- All statuses --</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-page="/Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Customer Name</th>
            <th>Product Name</th>
            <th>Serial Number</th>
            <th>Claim Type</th>
            <th>Status</th>
            <th>Assigned Agent</th>
            <th>Manufacturer Deadline</th>
            <th>Warranty Expiry</th>
            <th>Submitted Date</th>
            <th>Alerts</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var claim in Model.Claims)
    {
        var isManufacturerUrgent = ClaimAlertEvaluator.IsManufacturerDeadlineUrgent(claim);
        var isWarrantyUrgent = ClaimAlertEvaluator.IsWarrantyExpiryUrgent(claim);
        var isSlaBreached = ClaimAlertEvaluator.IsSlaBreached(claim);

        <tr>
            <td>
                <a asp-page="/ClaimDetail" asp-route-id="@claim.Id">
                    @claim.CustomerName
                </a>
            </td>
            <td>@claim.ProductName</td>
            <td>@claim.SerialNumber</td>
            <td>@claim.ClaimType</td>
            <td>@claim.Status</td>
            <td>@claim.AssignedAgent</td>
            <td>@(claim.ManufacturerDeadline?.ToString("d") ?? "-")</td>
            <td>@(claim.WarrantyExpiry?.ToString("d") ?? "-")</td>
            <td>@claim.SubmittedDate.ToString("d")</td>
            <td>
                @if (isManufacturerUrgent)
                {
                    <span class="badge bg-danger" title="Manufacturer deadline within 3 days or passed">Deadline</span>
                }
                @if (isWarrantyUrgent)
                {
                    <span class="badge" style="background-color:#fd7e14;" title="Warranty expiring within 7 days or passed">Warranty</span>
                }
                @if (isSlaBreached)
                {
                    <span class="badge bg-warning text-dark" title="Still Submitted more than 48 hours after submission">Needs attention</span>
                }
            </td>
        </tr>
    }
    @if (!Model.Claims.Any())
    {
        <tr>
            <td colspan="10" class="text-center text-muted">No claims found.</td>
        </tr>
    }
    </tbody>
</table>
